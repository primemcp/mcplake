{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/app"]
    },
    "playwright" :{
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "codegraph": {
      "command": "npx",
      "args": [
        "-y",
        "@cartographai/mcp-server-codegraph",
        "/app"
      ]
    }
  }
}