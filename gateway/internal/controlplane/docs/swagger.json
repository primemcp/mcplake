{
    "swagger": "2.0",
    "info": {
        "description": "Admin API for registering downstream MCPs and managing access/filter policies. See ADR-0005 and ADR-0007.",
        "title": "MCP Gateway Control-Plane Admin API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/admin",
    "paths": {
        "/access-policies": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "access-policies"
                ],
                "summary": "List access policies",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/controlplane.accessPolicyDTO"
                            }
                        }
                    }
                }
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "access-policies"
                ],
                "summary": "Create an access policy",
                "parameters": [
                    {
                        "description": "Access policy",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controlplane.accessPolicyRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/controlplane.accessPolicyDTO"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controlplane.errorResponse"
                        }
                    }
                }
            }
        },
        "/access-policies/{name}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "access-policies"
                ],
                "summary": "Get an access policy",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Policy name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controlplane.accessPolicyDTO"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controlplane.errorResponse"
                        }
                    }
                }
            },
            "put": {
                "description": "Creates it if absent.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "access-policies"
                ],
                "summary": "Replace an access policy",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Policy name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Access policy",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controlplane.accessPolicyRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controlplane.accessPolicyDTO"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controlplane.errorResponse"
                        }
                    }
                }
            },
            "delete": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "access-policies"
                ],
                "summary": "Delete an access policy",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Policy name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controlplane.errorResponse"
                        }
                    }
                }
            }
        },
        "/auth/config": {
            "get": {
                "description": "How the embedded admin web UI should authenticate: whether admin auth is enforced and, if so, the OIDC Authorization Code + PKCE coordinates to use. Unauthenticated — a browser with no token yet has to be able to read it (ADR-0014). Discloses only the public half of a PKCE client (client_id, provider endpoints, scopes); there is no client secret.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Admin UI login configuration",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controlplane.AuthInfo"
                        }
                    }
                }
            }
        },
        "/filter-policies": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "filter-policies"
                ],
                "summary": "List filter policies",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/controlplane.filterPolicyDTO"
                            }
                        }
                    }
                }
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "filter-policies"
                ],
                "summary": "Create a filter policy",
                "parameters": [
                    {
                        "description": "Filter policy",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controlplane.filterPolicyRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/controlplane.filterPolicyDTO"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controlplane.errorResponse"
                        }
                    }
                }
            }
        },
        "/filter-policies/{name}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "filter-policies"
                ],
                "summary": "Get a filter policy",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Policy name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controlplane.filterPolicyDTO"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controlplane.errorResponse"
                        }
                    }
                }
            },
            "put": {
                "description": "Creates it if absent.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "filter-policies"
                ],
                "summary": "Replace a filter policy",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Policy name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Filter policy",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controlplane.filterPolicyRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controlplane.filterPolicyDTO"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controlplane.errorResponse"
                        }
                    }
                }
            },
            "delete": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "filter-policies"
                ],
                "summary": "Delete a filter policy",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Policy name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controlplane.errorResponse"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Control-plane health check",
                "responses": {
                    "200": {
                        "description": "ok",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/mcps": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "mcps"
                ],
                "summary": "List registered MCPs",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/controlplane.mcpRegistrationDTO"
                            }
                        }
                    }
                }
            },
            "post": {
                "description": "Connects to the MCP, discovers its tools, and makes it immediately callable via the data plane. Persisted only on success.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "mcps"
                ],
                "summary": "Register an MCP",
                "parameters": [
                    {
                        "description": "MCP registration",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controlplane.registerMCPRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/controlplane.mcpRegistrationDTO"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controlplane.errorResponse"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/controlplane.errorResponse"
                        }
                    }
                }
            }
        },
        "/mcps/{name}": {
            "delete": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "mcps"
                ],
                "summary": "Unregister an MCP",
                "parameters": [
                    {
                        "type": "string",
                        "description": "MCP name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controlplane.errorResponse"
                        }
                    }
                }
            },
            "patch": {
                "description": "Toggles the registration's `enabled` flag in place without reconnecting. A disabled MCP rejects every data-plane call with 403 mcp_disabled.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "mcps"
                ],
                "summary": "Enable or disable an MCP",
                "parameters": [
                    {
                        "type": "string",
                        "description": "MCP name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Desired state",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controlplane.setEnabledRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controlplane.mcpRegistrationDTO"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controlplane.errorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controlplane.errorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "controlplane.AuthInfo": {
            "type": "object",
            "properties": {
                "auth_required": {
                    "description": "AuthRequired mirrors whether the admin-auth gate is installed. When\nfalse the UI skips the login flow entirely and behaves as it did\nbefore ADR-0010.",
                    "type": "boolean"
                },
                "authorization_endpoint": {
                    "description": "AuthorizationEndpoint is where the UI redirects the browser.",
                    "type": "string"
                },
                "client_id": {
                    "description": "ClientID is the public client registered for the UI.",
                    "type": "string"
                },
                "issuer": {
                    "description": "Issuer is oidc.issuer, shown to the operator so they can see which\nprovider they are about to be sent to.",
                    "type": "string"
                },
                "scopes": {
                    "description": "Scopes is what to request. Empty when login isn't configured.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "token_endpoint": {
                    "description": "TokenEndpoint is where the UI exchanges the code for a token.",
                    "type": "string"
                }
            }
        },
        "controlplane.accessPolicyDTO": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "grants": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/controlplane.grantDTO"
                    }
                },
                "match": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/controlplane.claimRuleDTO"
                    }
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "controlplane.accessPolicyRequest": {
            "type": "object",
            "properties": {
                "enabled": {
                    "description": "Enabled is optional; omitting it means enabled (see enabledOrTrue).",
                    "type": "boolean"
                },
                "grants": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/controlplane.grantDTO"
                    }
                },
                "match": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/controlplane.claimRuleDTO"
                    }
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "controlplane.claimRuleDTO": {
            "type": "object",
            "required": [
                "path",
                "pattern"
            ],
            "properties": {
                "path": {
                    "type": "string"
                },
                "pattern": {
                    "type": "string"
                }
            }
        },
        "controlplane.connectConfigDTO": {
            "type": "object",
            "properties": {
                "arguments": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "command": {
                    "type": "string"
                },
                "env": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "controlplane.errorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "controlplane.filterPolicyDTO": {
            "type": "object",
            "properties": {
                "drop_fields": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "match": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/controlplane.claimRuleDTO"
                    }
                },
                "mcp": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "tool": {
                    "type": "string"
                }
            }
        },
        "controlplane.filterPolicyRequest": {
            "type": "object",
            "required": [
                "mcp",
                "tool"
            ],
            "properties": {
                "drop_fields": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "enabled": {
                    "description": "Enabled is optional; omitting it means enabled (see enabledOrTrue).",
                    "type": "boolean"
                },
                "match": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/controlplane.claimRuleDTO"
                    }
                },
                "mcp": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "tool": {
                    "type": "string"
                }
            }
        },
        "controlplane.grantDTO": {
            "type": "object",
            "required": [
                "mcp"
            ],
            "properties": {
                "mcp": {
                    "type": "string"
                },
                "tools": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "controlplane.mcpRegistrationDTO": {
            "type": "object",
            "properties": {
                "connect": {
                    "$ref": "#/definitions/controlplane.connectConfigDTO"
                },
                "enabled": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "tools": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/controlplane.toolSchemaDTO"
                    }
                },
                "transport": {
                    "type": "string"
                }
            }
        },
        "controlplane.registerMCPRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "connect": {
                    "$ref": "#/definitions/controlplane.connectConfigDTO"
                },
                "enabled": {
                    "description": "Enabled is optional; omitting it means enabled (see enabledOrTrue).",
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "transport": {
                    "type": "string"
                }
            }
        },
        "controlplane.setEnabledRequest": {
            "type": "object",
            "required": [
                "enabled"
            ],
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "controlplane.toolSchemaDTO": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "input_schema": {
                    "type": "object"
                },
                "name": {
                    "type": "string"
                },
                "output_schema": {
                    "type": "object"
                }
            }
        }
    }
}